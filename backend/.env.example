# Copy to backend/.env for local development. Never commit .env.
# Every setting is optional; defaults let the app start with no keys and no database.

# --- App ---
APP_NAME=Research Assistant API
# local | test | dev | prod
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true = one JSON object per log line (use when deployed)
LOG_JSON=false

# --- CORS ---
# Comma-separated list (or JSON list) of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase Postgres) ---
# Use the SQLAlchemy psycopg driver prefix: postgresql+psycopg://
# Use the Supabase *session* pooler (port 5432) or the direct connection string.
# Do NOT use the transaction pooler (port 6543): it breaks psycopg prepared statements.
# Leave empty to run without a database (/health/ready then reports "not_configured").
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=3
READINESS_TIMEOUT_SECONDS=5

# --- Auth (Supabase) ---
# Project URL, e.g. https://<ref>.supabase.co. Empty = authenticated endpoints return 503.
# Required when ENVIRONMENT=prod (the app refuses to start without it).
SUPABASE_URL=
# Optional; defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
JWT_AUDIENCE=authenticated
# Clock skew allowed on exp/nbf, in seconds.
JWT_LEEWAY_SECONDS=30
JWKS_CACHE_SECONDS=600
JWKS_TIMEOUT_SECONDS=5

# --- Document storage (Supabase Storage) ---
# Secret key (Project Settings → API Keys, sb_secret_...). Server-side only; never in the frontend.
# Empty = document endpoints return 503. Required when ENVIRONMENT=prod.
SUPABASE_SECRET_KEY=
# Private bucket created in the dashboard (docs/SETUP.md), never from code.
STORAGE_BUCKET=documents
STORAGE_TIMEOUT_SECONDS=30
# Lifetime of the signed download URL from GET /documents/{id}/file.
SIGNED_URL_TTL_SECONDS=300

# --- Uploads and ingestion ---
# 25 MB (FR-03).
MAX_UPLOAD_BYTES=26214400
# Ingestions running at once; later uploads wait in status "uploaded".
INGESTION_CONCURRENCY=1
# In-progress documents not updated for this many minutes are marked failed (at startup and
# every INGESTION_SWEEP_INTERVAL_MINUTES), unless this process is still working on them.
INGESTION_STALE_MINUTES=15
INGESTION_SWEEP_INTERVAL_MINUTES=5

# --- Integration tests only (never read by the app; see docs/SETUP.md) ---
# SUPABASE_PUBLISHABLE_KEY=
# TEST_USER_A_EMAIL=
# TEST_USER_A_PASSWORD=
# TEST_USER_B_EMAIL=
# TEST_USER_B_PASSWORD=

# --- Provider selection ---
# "fake" providers need no keys or network (used by tests and CI).
# Two LLM tiers: "fast" (query analysis) and "strong" (synthesis, judging).
# fake | demo | groq | gemini. "fake" is the strict test double (unscripted calls fail);
# "demo" gives canned replies marked [DEMO OUTPUT] for key-free local runs (refused in prod).
# Model IDs are ignored by fake and demo.
LLM_FAST_PROVIDER=fake
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_STRONG_PROVIDER=fake
LLM_STRONG_MODEL=gemini-3.5-flash-lite
# Required when a tier uses that provider. Free keys: console.groq.com, aistudio.google.com.
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=60
# Retries after the first attempt (rate limit, 5xx, timeout), with backoff base * 2^n seconds.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1
# Client-side limits per tier model (0 = unlimited): requests/min, tokens/min, requests/day.
# Providers set quotas per model; tiers on the same model share the fast tier's limits.
# Defaults = free tiers on 2026-10-04: Groq docs (gpt-oss-20b) and AI Studio (gemini-3.5-flash-lite).
# Check yours at console.groq.com/settings/limits and aistudio.google.com/rate-limit.
# The daily count is in memory (a restart resets it); at the cap, calls fail at once.
LLM_FAST_RPM=30
LLM_FAST_TPM=8000
LLM_FAST_RPD=1000
LLM_STRONG_RPM=15
LLM_STRONG_TPM=250000
LLM_STRONG_RPD=500
# Graph tier (knowledge graph extraction only; SRS §9.1, D-083). fake | groq | gemini. "fake"
# leaves graph generation off. Its rate limiter is never shared with the tiers above. A model
# equal to LLM_FAST_MODEL or LLM_STRONG_MODEL is refused unless LLM_GRAPH_API_KEY (a different
# key, so a different quota) is set; without that key the provider's key above is used.
# The limits are provisional until a model is chosen.
LLM_GRAPH_PROVIDER=fake
LLM_GRAPH_MODEL=
LLM_GRAPH_API_KEY=
LLM_GRAPH_RPM=10
LLM_GRAPH_TPM=8000
LLM_GRAPH_RPD=300
# Graph-tier retries only (D-085): exponential backoff from the base (10, 20, 40, 80 s).
LLM_GRAPH_MAX_RETRIES=4
LLM_GRAPH_RETRY_BASE_SECONDS=10
# LangSmith tracing (smith.langchain.com). The key is required when tracing is on.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-assistant
# fake | sentence_transformers
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Must match the model and the database vector column; changing it needs a migration and re-indexing.
EMBEDDING_DIMENSION=384
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_BATCH_SIZE=16
# fake | cross_encoder
RERANKER_PROVIDER=fake
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Query + passage tokens; longer pairs are truncated.
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
# Hybrid retrieval: dense and full-text candidates, RRF constant, fused candidates sent to the
# reranker per sub-question, and the evidence kept after reranking.
DENSE_TOP_K=30
LEXICAL_TOP_K=30
RRF_K=60
RERANK_CANDIDATES=20
RETRIEVAL_TOP_K=8
# S3: best reranker score (0-1) that counts as covered without the LLM check, and chunks
# per sub-question the LLM check reads.
SUFFICIENCY_FAST_PASS_SCORE=0.97
SUFFICIENCY_CHECK_CHUNKS=8
# S5: longest citation quote, in characters.
CITATION_QUOTE_MAX_CHARS=300
# A4 comparison: evidence chunks per paper and attribute, and the most papers in one table or
# synthesis. A4 synthesis: evidence chunks per paper.
COMPARE_TOP_K=3
COMPARE_MAX_PAPERS=5
SYNTHESIS_TOP_K=4
# A4 contradictions: findings per paper, NLI contradiction score to reach the LLM check, and
# the most pairs checked per run.
CONTRADICTION_FINDINGS_PER_PAPER=3
CONTRADICTION_NLI_SCORE=0.5
CONTRADICTION_MAX_PAIRS=10
# A3: NLI entailment at or above the supported score is supported, below the unsupported score
# (0 = off) unsupported, in between (or contradicted at or above the contradiction score) goes to the
# LLM judge; NLI premise window in words; claims an answer needs after the last revision.
VERIFICATION_SUPPORTED_SCORE=0.9
VERIFICATION_UNSUPPORTED_SCORE=0.0
VERIFICATION_CONTRADICTION_SCORE=0.5
VERIFICATION_WINDOW_WORDS=120
VERIFICATION_MIN_CLAIMS=1
# A2 revisions after A3 finds unsupported or partial claims (SRS §7.3).
VERIFICATION_MAX_REVISIONS=2
# QA graph: checkpointer connection pool (schema `langgraph`, created by
# `uv run python -m scripts.setup_checkpointer`), and the sweep that fails runs left `running`
# by a restart. Runs waiting for approval are never swept.
CHECKPOINT_POOL_SIZE=4
QA_RUN_STALE_MINUTES=15
QA_RUN_SWEEP_INTERVAL_MINUTES=5
# Knowledge graph jobs (SRS §9.1, D-081, D-082): heartbeat while a job runs (also while it waits
# for rate limits), the stale time after which the sweep fails a job this process is not running,
# the sweep interval, and the most graph-tier LLM calls one job may make. The heartbeat must be
# shorter than the stale time.
KG_HEARTBEAT_SECONDS=60
KG_JOB_STALE_MINUTES=10
KG_JOB_SWEEP_INTERVAL_MINUTES=5
KG_MAX_CALLS_PER_JOB=150
# Extraction: passages shorter than this many words are skipped; at most this many passages
# per paper, this many per LLM call, and this output cap per call. NLI thresholds a
# relationship's quote must reach (provisional). Most nodes the graph endpoint returns.
KG_MIN_CHUNK_WORDS=40
KG_MAX_CHUNKS_PER_PAPER=60
KG_CHUNKS_PER_CALL=4
KG_MAX_OUTPUT_TOKENS=3000
KG_RELATION_ENTAILMENT_SCORE=0.9
KG_RELATION_CONTRADICTION_SCORE=0.5
KG_GRAPH_MAX_NODES=500
# Longest accepted question, in characters.
MAX_QUERY_CHARS=1000
# fake | cross_encoder
NLI_PROVIDER=fake
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
NLI_MAX_LENGTH=512
NLI_BATCH_SIZE=16

# --- Local models (embedding, reranker, NLI) ---
# true = load weights at startup (Docker); false = on first use (keeps --reload restarts fast).
PRELOAD_MODELS=false
# Local inference calls running at once; others queue.
LOCAL_INFERENCE_CONCURRENCY=1
# true = run the CPU benchmark once in the background at startup and log the table.
RUN_BENCHMARK_ON_STARTUP=false
# Pre-download weights: uv run python -m scripts.download_models
# fake | pymupdf4llm | docling
PARSER_PROVIDER=fake
# Average non-space text characters per page below which a PDF is rejected as scanned.
PDF_MIN_TEXT_CHARS_PER_PAGE=100
# Short lines on >= BOILERPLATE_MIN_PAGES pages and >= this share of pages are removed
# (running headers/footers, "Author Manuscript", page numbers).
BOILERPLATE_MIN_PAGES=3
BOILERPLATE_MIN_PAGE_FRACTION=0.5
BOILERPLATE_MAX_LINE_CHARS=200
# Chunk size in embedding-model tokens; overlap as a share of the target size.
CHUNK_MIN_TOKENS=350
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_RATIO=0.12
# Chunks under this merge into a neighbour in the same section (0 = never).
CHUNK_MERGE_BELOW_TOKENS=80
# Merged chunks never exceed this (bge-small/MiniLM take 512 tokens incl. 2 special tokens).
CHUNK_HARD_MAX_TOKENS=510
# Compatibility check (FR-22): a document's topic vector is the mean of its first chunks; the
# pre-upload check parses only the first pages. Cosine to the workspace centroid below the
# threshold warns the user (calibrated in D-060).
COMPATIBILITY_CHUNKS=4
COMPATIBILITY_MAX_PAGES=3
COMPATIBILITY_THRESHOLD=0.83
# Workspace keyword summary (S7, D-068): titles and first chunks of up to this many ready
# documents, each cut to this many characters, go to one strong-tier LLM call.
TOPIC_SUMMARY_MAX_DOCUMENTS=20
TOPIC_SUMMARY_CHARS_PER_DOCUMENT=1500
# Scholarly APIs. fake | live
# "live": DOI lookup (Crossref, then OpenAlex), and Discover search and PDF import
# (arXiv, OpenAlex; D-077). "fake" also turns Discover imports into a no-PDF stub.
SEARCH_PROVIDER=fake
# Sent to Crossref/OpenAlex/arXiv (User-Agent and mailto) for their polite pool. Required when
# SEARCH_PROVIDER=live. Use a team address you are happy to share with these services.
CONTACT_EMAIL=
SCHOLARLY_TIMEOUT_SECONDS=5
# Optional free OpenAlex API key (create at openalex.org/settings/api). Without it OpenAlex
# allows about 100 searches a day per IP address (10 credits each, 1,000 credits a day); with
# it about 1,000. Sent only to OpenAlex, in a header. Single-paper lookups are free either way.
OPENALEX_API_KEY=
# DOI candidates from pages 1-2 checked against the lookup per document.
DOI_MAX_CANDIDATES=3
# Without a confirmed DOI, this many characters of page 1 go to the fast-tier LLM for
# title, authors, year, and venue (FR-04, D-068).
METADATA_LLM_MAX_CHARS=6000
# Discover (D-077): results per source; arXiv API pacing (its terms ask for one call per 3 s);
# time to check that listed PDFs answer, per search; PDF download redirects and timeout.
# Downloads are capped at MAX_UPLOAD_BYTES.
DISCOVER_MAX_RESULTS=10
ARXIV_REQUESTS_PER_MINUTE=20
DISCOVER_PDF_CHECK_SECONDS=4
IMPORT_MAX_REDIRECTS=3
IMPORT_TIMEOUT_SECONDS=30
# Discover search and paper lookups (DOI lookups keep SCHOLARLY_TIMEOUT_SECONDS); one whole
# PDF download; all PDF locations of one import together (D-079).
DISCOVER_TIMEOUT_SECONDS=15
IMPORT_DOWNLOAD_DEADLINE_SECONDS=90
IMPORT_BUDGET_SECONDS=120
# Web search, used only after Corpus + Web approval. fake | tavily
WEB_SEARCH_PROVIDER=fake
# Evaluation CLI (`uv run python -m eval.run`): the Ragas judge. It must differ from the strong
# tier (A3's judge). fake | groq | gemini. Limits = Groq free tier for gpt-oss-120b.
EVAL_JUDGE_PROVIDER=fake
EVAL_JUDGE_MODEL=openai/gpt-oss-120b
EVAL_JUDGE_RPM=30
EVAL_JUDGE_TPM=8000
EVAL_JUDGE_RPD=1000
# Questions the judge generates per answer for Ragas answer relevancy.
EVAL_ANSWER_RELEVANCY_STRICTNESS=3
