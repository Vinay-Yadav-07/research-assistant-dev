# Copy to frontend/.env.local for local development. Never commit .env files.
# Backend base URL (no trailing slash). Inlined into the browser bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Supabase project (dev locally, prod on Vercel): Project Settings → API Keys. Without them sign-in is unavailable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: GitHub repository URL shown in footer
NEXT_PUBLIC_GITHUB_URL=
